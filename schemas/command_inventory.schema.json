{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/cst_history_extractor/command_inventory.schema.json",
  "title": "CST History Command Inventory",
  "type": "object",
  "required": [
    "project_id",
    "source",
    "history_item_count",
    "classified_commands",
    "unknown_commands"
  ],
  "properties": {
    "project_id": { "type": "string" },
    "source": { "type": "string" },
    "history_item_count": { "type": "integer", "minimum": 0 },
    "classified_commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/classified_command" }
    },
    "unknown_commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/classified_command" }
    }
  },
  "$defs": {
    "classified_command": {
      "type": "object",
      "required": [
        "index",
        "raw_name",
        "category",
        "subcategory",
        "confidence",
        "evidence",
        "raw_macro_excerpt"
      ],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "raw_name": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "raw_macro_excerpt": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
