{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feature Graph Draft",
  "type": "object",
  "required": ["schema_version", "source_geometry_manifest", "features", "unassigned_faces"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "source_geometry_manifest": { "type": "string" },
    "model_type": { "type": "string" },
    "axis": { "enum": ["x", "y", "z"] },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "geometry_refs", "confidence", "evidence", "status", "requires_human_review"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "geometry_refs": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["candidate", "confirmed", "rejected", "modified", "unknown"] },
          "requires_human_review": { "type": "boolean" },
          "default_boundary_role": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "face_groups": { "type": "array", "items": { "type": "object" } },
    "unassigned_faces": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
